# Copy this file to .env and fill in the values:  cp .env.example .env
# The API server and the web app both read this one file.

# --- LaunchDarkly (required for the demo) -----------------------------------
# Project settings > Environments > <environment> (e.g. "Test" or "Production")
# >>> REPLACE ME: server-side SDK key - used by the API server and the experiment simulator. Keep it secret.
LD_SDK_KEY=sdk-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# >>> REPLACE ME: client-side ID - used by the browser. Safe to expose.
VITE_LD_CLIENT_SIDE_ID=xxxxxxxxxxxxxxxxxxxxxxxx

# >>> REPLACE ME (optional): flag trigger URL for wall-reactions-comments (Flag > Settings > Triggers). Optional but
# needed for the remediation demo. Treat it like a password.
LD_TRIGGER_URL=

# Fire the trigger automatically when the reactions API error rate spikes.
AUTO_REMEDIATE=true
REMEDIATION_ERROR_THRESHOLD=0.5
REMEDIATION_MIN_REQUESTS=5
REMEDIATION_WINDOW_MS=60000

# --- Sensei Assistant (AI Configs) - optional ------------------------------
# >>> REPLACE ME (optional): add the key for whichever provider your AI Config variations use.
# Without a key the assistant gives clearly labelled offline replies.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- App ---------------------------------------------------------------------
PORT=4000
# >>> REPLACE ME for any shared deployment: a long random secret for signing login cookies.
JWT_SECRET=change-me-to-a-long-random-string
# Demo control panel + persona switcher. Set both to false for a "customer-facing" build.
DEMO_MODE=true
VITE_DEMO_MODE=true
